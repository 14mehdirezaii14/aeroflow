# ─── API (NestJS REST backend) ───────────────────────────────
# When unset, the platform transparently falls back to the in-memory mock store.
NEXT_PUBLIC_API_URL=

# Optional auth token injected by the Axios interceptor
NEXT_PUBLIC_AUTH_TOKEN_KEY=aeroflow_token

# Deployment
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
